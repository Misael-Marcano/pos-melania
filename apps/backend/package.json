{
  "name": "@pos/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API del POS multi-tenant (Express, TypeORM, ventas, inventario, billing SaaS).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "migration:generate": "typeorm migration:generate -d src/config/database.ts",
    "migration:run": "ts-node -e \"require('./src/config/database').AppDataSource.initialize().then((ds: import('typeorm').DataSource) => ds.runMigrations()).then(() => process.exit(0))\"",
    "migration:revert": "ts-node -e \"require('./src/config/database').AppDataSource.initialize().then((ds: import('typeorm').DataSource) => ds.undoLastMigration()).then(() => process.exit(0))\"",
    "seed": "ts-node src/seeds/initial.seed.ts",
    "openapi:export": "ts-node src/scripts/export-openapi.ts",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js"
  },
  "dependencies": {
    "@pos/shared": "*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "stripe": "^17.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.29",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.14",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
