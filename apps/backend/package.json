{
  "name": "@pos/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migration:generate": "typeorm migration:generate -d src/config/database.ts",
    "migration:run": "ts-node -e \"require('./src/config/database').AppDataSource.initialize().then(ds => ds.runMigrations()).then(() => process.exit(0))\"",
    "migration:revert": "ts-node -e \"require('./src/config/database').AppDataSource.initialize().then(ds => ds.undoLastMigration()).then(() => process.exit(0))\"",
    "seed": "ts-node src/seeds/initial.seed.ts",
    "test": "jest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "typeorm": "^0.3.20",
    "mssql": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "ioredis": "^5.4.1",
    "pdfkit": "^0.15.0",
    "winston": "^3.14.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "@pos/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/pdfkit": "^0.13.4",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.2.4"
  }
}
