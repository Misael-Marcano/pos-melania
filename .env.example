# Nombres de secretos y cabeceras sensibles: docs/operacion/SECRETS-RUNBOOK.md
# (no pegar valores reales en git; ver también docs/operacion/DEPLOY-SAAS.md)

# ============================
# BASE DE DATOS — SQL Server
# ============================
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASS=changeme_local_dev_only
DB_NAME=pos_melania

# ============================
# JWT — Autenticación
# ============================
JWT_SECRET=pos_melania_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=pos_melania_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# REDIS — Cache / Sesiones
# ============================
REDIS_URL=redis://localhost:6379

# ============================
# SERVIDOR
# ============================
PORT=4000
NODE_ENV=development

# ============================
# SaaS Fase 0 — política (decisiones en docs/arquitectura/SAAS-FASE-0-DECISIONES.md)
# ============================
# Origen del frontend: CORS en app.ts y enlaces en emails de facturación (billing.webhook).
# Producción: https://app.tudominio.com (debe coincidir con el dominio real del cliente Next.js).
FRONTEND_URL=http://localhost:3000

# Orientativos para Fase 2+ (trial / registro público). El backend aún no las lee hasta implementarse.
# SAAS_TRIAL_DAYS=14
# SAAS_TRIAL_PLAN_CODE=starter
# PUBLIC_REGISTRATION_ENABLED=false

# ============================
# FISCAL — instancia (backend, Fase C)
# ============================
# DO = DGII / NCF (valor por defecto si la variable no se define). NONE / OFF / MOCK = sin NCF (mismo proveedor; ver docs/operacion/jurisdicciones/NONE-MOCK.md).
# La columna configuracion.fiscalJurisdiccion (API / pantalla Configuración) puede sobrescribir esto por BD.
# FISCAL_JURISDICTION=DO

# ============================
# SaaS / multi-organización (Fase D)
# ============================
# Si true, el login exige cabecera X-Tenant-Slug (API y cliente deben enviar slug de organización).
# LOGIN_REQUIRE_TENANT_SLUG=false

# ============================
# Stripe y facturación SaaS (runtime API)
# ============================
# Mismos nombres que docs/operacion/DEPLOY-SAAS.md §4 y docs/operacion/SECRETS-RUNBOOK.md §2 (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET).
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_STANDARD=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# Webhook POST /api/v1/billing/webhook (body raw; ver docs/arquitectura/BILLING-SAAS.md)
# Bloqueo por impago: poner true para devolver 402 cuando billingStatus=past_due/canceled/unpaid
# (opt-in; false por defecto para no romper despliegues sin Stripe configurado)
# BILLING_ENFORCE_PAYMENT=false
# Trial vencido sin suscripción activa/trialing → 402 (opt-in; requiere tenants.trialEndsAt)
# TRIAL_ENFORCE_EXPIRED=false
# Customer ID de Stripe para el happy-path del test de integración del portal (backend)
# TEST_STRIPE_CUSTOMER_ID=cus_...

# ============================
# Email (SMTP) — notificaciones de billing y trial
# ============================
# Misma forma que docs/operacion/DEPLOY-SAAS.md §5 (NOTIFICATIONS_EMAIL_ENABLED + SMTP_*).
# Poner true para habilitar emails en eventos de facturación (Stripe) y recordatorios de trial (con cron).
# NOTIFICATIONS_EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=secreto
# SMTP_FROM="POS App <noreply@example.com>"
#
# Ejemplos de proveedores:
#   Gmail:    SMTP_HOST=smtp.gmail.com SMTP_PORT=587 (requiere App Password)
#   Resend:   SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=<api_key>
#   SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey SMTP_PASS=<api_key>

# ============================
# Cron — recordatorios de trial (API interna)
# ============================
# POST /api/v1/internal/cron/trial-reminders con cabecera X-Cron-Secret (valor = CRON_SECRET).
# docs/operacion/SECRETS-RUNBOOK.md §2, docs/operacion/DEPLOY-SAAS.md §5 (recordatorios de trial).
# CRON_SECRET=

# ============================
# E2E Playwright (staging / GitHub Actions)
# ============================
# Consumidas por apps/frontend (playwright.config.ts, e2e/*); secretos del repo: E2E_EMAIL, E2E_PASSWORD, PLAYWRIGHT_BASE_URL.
# docs/operacion/SECRETS-RUNBOOK.md §1, .github/workflows/e2e-manual.yml. No son variables del proceso Node del API.
# E2E_EMAIL=
# E2E_PASSWORD=
# PLAYWRIGHT_BASE_URL=https://staging-app.example.com

# ============================
# FRONTEND (Next.js)
# ============================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Slug de organización fijo por despliegue (opcional). Si no se define, se puede derivar del subdominio
# (p. ej. acme.tudominio.com → acme) vía `apps/frontend/src/lib/login-tenant-slug.ts`.
# NEXT_PUBLIC_TENANT_SLUG=default

# Marca en UI (Fase A — POS genérico). Ejemplo Melania: SHORT_NAME=Melania, TAGLINE=Sopa EIRL
# NEXT_PUBLIC_APP_SHORT_NAME=POS
# NEXT_PUBLIC_APP_TAGLINE=Punto de venta
# NEXT_PUBLIC_APP_METADATA_TITLE=POS — Punto de venta
# NEXT_PUBLIC_APP_METADATA_DESCRIPTION=Sistema de punto de venta e inventario
# NEXT_PUBLIC_APP_COPYRIGHT_ENTITY=Mi empresa SRL

# Contacto en la landing page (botones de planes → modal de contacto)
# NEXT_PUBLIC_CONTACT_EMAIL=ventas@gmail.com
# NEXT_PUBLIC_CONTACT_WHATSAPP=8299296616   # sin + ni espacios, con código de país

# Etiquetas y módulos (Fase B — retail vs producción / BOM)
# NEXT_PUBLIC_LABEL_BREADCRUMB_ROOT=Sistema POS
# NEXT_PUBLIC_FEATURE_RECETAS=true
# NEXT_PUBLIC_LABEL_RECETAS=Recetas
# NEXT_PUBLIC_LABEL_RECETA=Receta
# NEXT_PUBLIC_LABEL_RECETAS_HEADER=Recetas de producción
# Reportes (`/reportes`): título en menú / cabecera y pestañas (agrupaciones)
# NEXT_PUBLIC_LABEL_REPORTES=Reportes
# NEXT_PUBLIC_LABEL_REPORTES_HEADER=Análisis y reportes
# NEXT_PUBLIC_LABEL_REPORTES_TAB_VENTAS=Ventas
# NEXT_PUBLIC_LABEL_REPORTES_TAB_PNL=P&L
# NEXT_PUBLIC_LABEL_REPORTES_TAB_INVENTARIO=Inventario
# NEXT_PUBLIC_LABEL_REPORTES_TAB_CLIENTES=Clientes
# NEXT_PUBLIC_LABEL_REPORTES_TAB_SUCURSAL=Por sucursal
# NEXT_PUBLIC_LABEL_REPORTES_TAB_DGII=DGII

# ============================
# OpenAPI / Swagger (backend)
# ============================
# Producción: SWAGGER_ENABLED=false (docs/operacion/DEPLOY-SAAS.md §10).
# SWAGGER_ENABLED=false
# URL pública del API en la spec (apps/backend/src/config/swagger.ts); por defecto http://localhost:${PORT}
# API_PUBLIC_URL=https://api.tudominio.com
# OPENAPI_TITLE=POS API
# OPENAPI_DESCRIPTION=API del punto de venta
